---
import "../styles/lineage.css";
import "../styles/playground.css";
import CuriosityDrawers from "../components/CuriosityDrawers.astro";
import "../styles/curiosity.css";
import ExperimentSwitcher from "../components/ExperimentSwitcher.astro";
import {localeFromPath,localePath,basePath,withSiteBase,type Locale} from "../i18n/core";
import dmSansLatin from "../assets/fonts/dm-sans-latin.woff2?url";
import spaceGroteskLatin from "../assets/fonts/space-grotesk-latin.woff2?url";
interface Props { title: string; description: string; image?: string; }
const { title, description, image = "/og/home.png" } = Astro.props;
const locale=localeFromPath(Astro.url.pathname);
const path=basePath(Astro.url.pathname);
// Social and search tags need absolute URLs; localePath and withSiteBase add the project base once.
const origin=new URL(Astro.site ?? "https://thesybuilder.github.io").origin;
const canonical=origin+localePath(path,locale);
const ogImage=origin+withSiteBase(image);
const alternates:[string,Locale][]=[["en","en"],["zh-CN","zh"],["ar","ar"],["x-default","en"]];
const languages:[Locale,string][]=[["en","English"],["zh","中文"],["ar","العربية"]];
---
<!doctype html>
<html lang={locale==='zh'?'zh-CN':locale} dir={locale==='ar'?'rtl':'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>try{var t=localStorage.getItem("lineage-theme");if(t==="light"||t==="dark")document.documentElement.dataset.theme=t;}catch(e){}</script>
    <link rel="preload" href={dmSansLatin} as="font" type="font/woff2" crossorigin /><link rel="preload" href={spaceGroteskLatin} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" />
    <meta property="og:site_name" content="LLM Lineage" /><meta property="og:url" content={canonical} /><meta property="og:image" content={ogImage} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:site" content="@TheSyBuilder" /><meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={canonical} />{alternates.map(([hreflang,code])=><link rel="alternate" hreflang={hreflang} href={origin+localePath(path,code)} />)}
    <meta name="theme-color" content="#faf9f5" media="(prefers-color-scheme: light)" /><meta name="theme-color" content="#171914" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Ccircle cx='32' cy='32' r='32' fill='%23b9e64b'/%3E%3Cpath d='M17 16v27h13M34 22v27h13' fill='none' stroke='%23252821' stroke-width='6'/%3E%3C/svg%3E" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="LLM Lineage home"><span class="brand-mark" aria-hidden="true">L<span>L</span></span><strong>LLM Lineage</strong></a>
      <nav class="site-nav" aria-label="Main navigation"><button class="nav-experiments" type="button" data-open-explorer>Explore<kbd aria-hidden="true">⌘K</kbd></button><a class="nav-timeline" href="/#timeline">The timeline</a><a class="icon-link repo-link" href="https://github.com/TheSyBuilder/how-llms-happened" aria-label="GitHub repository"><svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg><span>GitHub</span></a><a class="icon-link social-link" href="https://x.com/TheSyBuilder" aria-label="X profile"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.67l7.73-8.84L1.25 2.25h6.83l4.71 6.23Zm-1.16 17.52h1.83L7.08 4.13H5.12Z"/></svg></a><button class="theme-toggle" type="button" aria-pressed="false" aria-label="Dark theme" title="Dark theme" data-theme-toggle><svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg><svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1Z" fill="currentColor"/></svg></button></nav>
      <nav class="language-switch" aria-label="Language"><div class="language-links">{languages.map(([code,label])=><a data-language={code} lang={code==='zh'?'zh-CN':code} href={localePath(path,code)} aria-current={locale===code?'page':undefined}>{label}</a>)}</div><details class="language-menu"><summary><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M2.5 12h19M12 2.5c2.6 2.6 3.9 5.8 3.9 9.5s-1.3 6.9-3.9 9.5c-2.6-2.6-3.9-5.8-3.9-9.5s1.3-6.9 3.9-9.5Z" fill="none" stroke="currentColor" stroke-width="2"/></svg><span class="screen-reader-only">Language</span></summary><div class="language-menu-list">{languages.map(([code,label])=><a data-language={code} lang={code==='zh'?'zh-CN':code} href={localePath(path,code)} aria-current={locale===code?'page':undefined}>{label}</a>)}</div></details></nav>
    </header>
    <ExperimentSwitcher />
    <CuriosityDrawers />
    <main id="main-content"><slot /></main>
    <footer class="site-footer"><a class="brand" href="/">LLM Lineage</a><div><p>Big ideas. Small experiments. A history you can play with.</p><button class="curiosity-invitation" data-curiosity="tokens">One more token?</button></div><a href="/#timeline">Back to the timeline ↑</a></footer>
  </body>
</html>

<script>
for(const link of document.querySelectorAll<HTMLAnchorElement>('[data-language]'))link.addEventListener('click',()=>{const target=new URL(link.href);target.hash=location.hash;link.href=target.href;});
const menu=document.querySelector<HTMLDetailsElement>('.language-menu');
document.addEventListener('click',e=>{if(menu?.open&&!menu.contains(e.target as Node))menu.open=false;});
menu?.addEventListener('keydown',e=>{if(e.key==='Escape'&&menu.open){menu.open=false;menu.querySelector('summary')?.focus();}});
// The head script applies a stored choice before paint; this keeps the toggle, theme-color and storage in step.
const root=document.documentElement,toggle=document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
const systemDark=matchMedia('(prefers-color-scheme: dark)');
const current=()=>root.dataset.theme==='dark'||root.dataset.theme==='light'?root.dataset.theme:systemDark.matches?'dark':'light';
function syncTheme(){
 toggle?.setAttribute('aria-pressed',String(current()==='dark'));
 // A forced theme overrides both media-scoped theme-color tags with the live paper colour.
 if(root.dataset.theme){const paper=getComputedStyle(root).getPropertyValue('--paper').trim();for(const meta of document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]'))meta.content=paper;}
}
toggle?.addEventListener('click',()=>{const next=current()==='dark'?'light':'dark';root.dataset.theme=next;try{localStorage.setItem('lineage-theme',next);}catch{}syncTheme();});
systemDark.addEventListener('change',syncTheme);
syncTheme();
</script>
