---
import { firstSteps } from '../lib/first-steps';
const {slug}=Astro.props;
const discovery=firstSteps[slug];
---
{discovery && <section class="chapter-end" aria-label="Take the idea with you"><p class="eyebrow">Tell a friend</p><p>{discovery.idea}</p><div><button class="share-experiment" type="button">Copy experiment link</button><a href="https://github.com/TheSyBuilder/how-llms-happened">Enjoyed this? Star on GitHub ↗</a></div><span class="share-status" role="status"></span></section>}
<script>
import {t} from "../i18n/core";
for(const button of document.querySelectorAll<HTMLButtonElement>('.share-experiment')) button.addEventListener('click',async()=>{
 const url=new URL(location.href);url.hash='play';
 const status=button.closest('.chapter-end')!.querySelector('.share-status')!;
 try{await navigator.clipboard.writeText(url.href);status.textContent=t('Experiment link copied.');}catch{status.textContent=t(`Copy this link: ${url.href}`);}
});
</script>
