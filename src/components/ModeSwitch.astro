---
import type { Mode } from "../lib/site-data";

interface Props {
  activeMode: Mode;
  alternateHref: string;
}

const { activeMode, alternateHref } = Astro.props;
const alternate = activeMode === "beginner" ? "expert" : "beginner";
---

<div class="mode-switch" aria-label="Learning mode">
  <span class="mode-current"><span aria-hidden="true">●</span> {activeMode} mode</span>
  <a href={alternateHref}>Switch to {alternate}<span aria-hidden="true"> →</span></a>
</div>
