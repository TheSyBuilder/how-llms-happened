---
import type { EvidenceView } from "../lib/site-data";

interface Props {
  evidence: EvidenceView;
  open?: boolean;
}

const { evidence, open = false } = Astro.props;
---

<details class="evidence-details" open={open || undefined}>
  <summary>
    <span class="evidence-mark" aria-hidden="true">§</span>
    Evidence · {evidence.sources[0]?.locator ?? evidence.claimId}
  </summary>
  <div class="evidence-body">
    <p class="claim-id">{evidence.claimId}</p>
    <p>{evidence.statement}</p>
    <dl class="evidence-meta">
      <div>
        <dt>Support</dt>
        <dd>{evidence.directness} · {evidence.confidence} confidence</dd>
      </div>
      <div>
        <dt>Version scope</dt>
        <dd>{evidence.versionIds.join(", ")}</dd>
      </div>
    </dl>
    {evidence.sources.map((source) => (
      <div class="source-row">
        <p><strong>{source.locator}</strong></p>
        <p>{source.support}</p>
        <a href={source.url} rel="noreferrer">Open {source.title}</a>
        <small>Accessed {source.accessDate}. {source.accessNote}</small>
      </div>
    ))}
    {evidence.limitations.length > 0 && (
      <div class="evidence-limits">
        <strong>Boundary</strong>
        <ul>{evidence.limitations.map((item) => <li>{item}</li>)}</ul>
      </div>
    )}
    <a class="claim-link" href={`/reference/works/${evidence.workId}/#claim-${evidence.claimId}`}>
      Inspect this claim in the work record
    </a>
  </div>
</details>
