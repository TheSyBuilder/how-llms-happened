---
import AtlasEvidence from "./AtlasEvidence.astro";
import AtlasUncertainties from "./AtlasUncertainties.astro";
import { authorSummary, type AtlasRelation } from "../lib/atlas-data";
interface Props { relation: AtlasRelation; idPrefix?: string; indexHref?: string }
const { relation, idPrefix = "relation", indexHref = "#relationships" } = Astro.props;
const { record, from, to } = relation;
---
<article class="atlas-relation" id={`${idPrefix}-${record.id}`} data-relation-id={record.id} data-evidence-class={record.evidenceClass} data-causal-language={record.causalLanguage}>
  <details class="atlas-disclosure">
    <summary>
      <span class:list={["atlas-line", `atlas-line--${record.evidenceClass}`]} aria-hidden="true"></span>
      <span>{authorSummary(from.record.authors)} ({from.orderingEvent.date.value}) / {authorSummary(to.record.authors)} ({to.orderingEvent.date.value})<small>{record.connectionType} · {record.evidenceClass} · causal language {record.causalLanguage}</small></span>
    </summary>
    <div class="atlas-detail-body">
      <p class="claim-id">{record.id}</p>
      <p><strong>Record orientation:</strong> from <a href={`/atlas/expert/#work-${from.record.id}`}>{from.record.title}</a>; to <a href={`/atlas/expert/#work-${to.record.id}`}>{to.record.title}</a>.</p>
      <p class="atlas-small">Beginner context: <a href={`/atlas/beginner/#work-${from.record.id}`}>from work</a> / <a href={`/atlas/beginner/#work-${to.record.id}`}>to work</a>. Expert context: the work-title links above.</p>
      <dl class="atlas-fields">
        <div><dt>Connection type</dt><dd>{record.connectionType}</dd></div>
        <div><dt>Evidential basis</dt><dd>{record.evidenceClass}</dd></div>
        <div><dt>Causal language</dt><dd>{record.causalLanguage}</dd></div>
        <div><dt>Confidence</dt><dd>{record.confidence}</dd></div>
      </dl>
      <p class="atlas-boundary">{record.causalLanguage === "prohibited" ? "Causal language prohibited. Record orientation does not claim derivation, inspiration or priority." : "Qualified connection: the recorded scope below applies. It does not establish universal causation or transfer all methods and results."}</p>
      <p>{record.rationale}</p>
      <AtlasEvidence evidence={record.sourceEvidence} />
      <div class="atlas-bound-claims"><strong>Bound claim statements</strong><ul>{relation.claims.map((claim) => <li><a href={`/atlas/expert/#claim-${claim.id}`}>{claim.statement}</a><small class="claim-id">{claim.id}</small></li>)}</ul></div>
      <AtlasUncertainties items={record.uncertainties} />
      <a href={indexHref}>Return to relationship index ↑</a>
    </div>
  </details>
</article>
