---
import { evidenceLensFields, evidenceLensLabels, type AtlasEvidenceLens } from "../lib/atlas-evidence-lens";
import type { AtlasRelation } from "../lib/atlas-data";
interface Props { caseKey: string; lensKey: string; label: string; view: AtlasEvidenceLens; incident: AtlasRelation[] }
const { caseKey, lensKey, label, view, incident } = Astro.props;
const id = `lens-${caseKey}-${lensKey}`;
const recordHref = (relation: AtlasRelation) => `#lens-${caseKey}-record-${relation.record.id}`;
const recordLabel = (relation: AtlasRelation) => `R${incident.indexOf(relation) + 1}`;
---
<details class="atlas-disclosure lens-detail" id={id} data-lens-key={lensKey}>
  <summary><span>{label}</span><small>{view.counts.matched} of {view.counts.total} here</small></summary>
  <div class="atlas-detail-body">
    <dl class="atlas-fields lens-constraints">
      {evidenceLensFields.map((field) => <div><dt>{evidenceLensLabels[field]}</dt><dd>{view.constraints[field] ?? "All admitted values"}</dd></div>)}
    </dl>
    <p class="atlas-small">Every selected field must match. An omitted field imposes no constraint.</p>
    <dl class="lens-counts" aria-label={`${label} record counts`}>
      <div><dt>Matched here</dt><dd>{view.counts.matched} <small>of {view.counts.total} incident records</small></dd></div>
      <div><dt>Excluded here</dt><dd>{view.counts.excluded} <small>of {view.counts.total} incident records</small></dd></div>
      <div><dt>Matched elsewhere</dt><dd>{view.counts.outsideMatched} <small>of {view.counts.outsideTotal} outside records</small></dd></div>
      <div><dt>Matched in corpus</dt><dd>{view.counts.globalMatched} <small>of {view.counts.globalTotal} total records</small></dd></div>
    </dl>
    {view.relationships.length > 0 ? <div class="lens-result-list"><h4>Matching incident records</h4><ul>{view.relationships.map((relation) => <li data-lens-match={relation.record.id}><a href={recordHref(relation)}>{recordLabel(relation)} · {relation.record.id}</a><small>{relation.record.evidenceClass} · causal language {relation.record.causalLanguage} · {relation.record.connectionType}</small></li>)}</ul></div>
      : <div class="atlas-boundary lens-empty" data-lens-empty><h4>No matching incident records.</h4><p>Under the constraints above, {view.counts.matched} of {view.counts.total} records in this neighborhood match. {view.counts.outsideMatched === 1 ? "1 matching record is" : `${view.counts.outsideMatched} matching records are`} elsewhere in the corpus. This subset does not establish the historical absence of influence.</p><p><a href={`#lens-${caseKey}-all`}>Inspect the All records lens</a> · <a href={`#lens-${caseKey}-evidence`}>Read every incident record</a></p></div>}
    {view.excluded.length > 0 && <div class="lens-result-list"><h4>Excluded incident records · every failed field</h4><ul>{view.excluded.map(({ relation, failedFields }) => <li data-lens-excluded={relation.record.id}><a href={recordHref(relation)}>{recordLabel(relation)} · {relation.record.id}</a><ul>{failedFields.map((field) => <li data-failed-field={field}>{evidenceLensLabels[field]}: requires <strong>{view.constraints[field]}</strong>; record has <strong>{relation.record[field]}</strong>.</li>)}</ul></li>)}</ul><p class="atlas-small">Exclusion concerns these constraints. It does not invalidate the record, change its confidence or remove its evidence.</p></div>}
    {view.outsideMatches.length > 0 && <details class="atlas-disclosure lens-outside"><summary>Inspect matching records elsewhere · {view.counts.outsideMatched}</summary><div class="atlas-detail-body"><p>These records do not touch the focus work. They stay outside its neighborhood. Links open the complete global relationship register.</p><ul>{view.outsideMatches.map((relation) => <li data-lens-outside={relation.record.id}><a href={`/atlas/evidence/#relation-${relation.record.id}`}>{relation.record.id}</a></li>)}</ul></div></details>}
    <a class="atlas-return" href={`#lens-${caseKey}-counts`}>Return to the count comparison ↑</a>
  </div>
</details>
