---
import {chapters,chapterPaper} from '../lib/chapters';
const live=chapters.filter(c=>c.status==='live');
---
<dialog class="experiment-switcher" aria-labelledby="switcher-title">
 <div class="switcher-top"><div><p class="eyebrow">LLM Lineage</p><h2 id="switcher-title">Pick your next idea.</h2></div><button class="close-switcher" aria-label="Close experiments">×</button></div>
 <label class="switcher-search"><span class="screen-reader-only">Search experiments and papers</span><input type="search" placeholder="Search an idea, paper, or year…" autocomplete="off" /></label>
 <div class="switcher-labels"><span>{live.length} experiments</span><span>Play / original paper</span></div>
 <ul class="switcher-list">{live.map((c,i)=>{const p=chapterPaper(c.anchor)!;return <li data-search={`${c.title} ${c.year} ${p.title}`.toLowerCase()}><a class="switcher-game" href={`/chapters/${c.slug}/#play`}><span>{String(i+1).padStart(2,'0')}</span><strong>{c.title}<small>{c.year}</small></strong><b aria-hidden="true">↗</b></a><a class="switcher-paper" target="_blank" rel="noopener noreferrer" href={p.url} aria-label={`Original paper: ${p.title}`} title={p.title}>Paper ↗</a></li>})}</ul>
 <p class="switcher-empty" hidden>No match. Try “attention”, “BERT”, or a year.</p>
</dialog>
<script>
const dialog=document.querySelector<HTMLDialogElement>('.experiment-switcher')!;
const search=dialog.querySelector<HTMLInputElement>('input')!;
const rows=[...dialog.querySelectorAll<HTMLElement>('[data-search]')];
const empty=dialog.querySelector<HTMLElement>('.switcher-empty')!;
let opener:HTMLElement|null=null;
const filter=()=>{let count=0;for(const row of rows){const matches=row.dataset.search!.includes(search.value.trim().toLowerCase());row.hidden=!matches;if(matches)count++;}empty.hidden=count>0;};
document.addEventListener('click',e=>{const target=(e.target as HTMLElement).closest<HTMLElement>('[data-open-explorer]');if(target){opener=target;search.value='';filter();dialog.showModal();document.body.classList.add('switcher-is-open');search.focus();}});
document.addEventListener('keydown',e=>{if(document.querySelector('.curiosity-dialog[open]'))return;if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();if(dialog.open){dialog.close();return;}opener=document.activeElement as HTMLElement;search.value='';filter();dialog.showModal();document.body.classList.add('switcher-is-open');search.focus();}});
const close=()=>dialog.close();
dialog.addEventListener('keydown',e=>{if(e.key==='Escape'){e.preventDefault();close();}});
dialog.querySelector('.close-switcher')!.addEventListener('click',close);
dialog.addEventListener('click',e=>{if(e.target===dialog){const rect=dialog.getBoundingClientRect();if(e.clientX<rect.left||e.clientX>rect.right||e.clientY<rect.top||e.clientY>rect.bottom)close();}});
dialog.addEventListener('close',()=>{document.body.classList.remove('switcher-is-open');opener?.focus();});
search.addEventListener('input',filter);
</script>
