      <rect x="45" y="105" width="390" height="55" rx="5" fill="var(--accent)"/><text x="240" y="140" text-anchor="middle">One shared vector table</text>
      <rect x="100" y="220" width="280" height="60" rx="5" class="neural-diagram-box"/><text x="240" y="258" text-anchor="middle">Neural predictor</text>
