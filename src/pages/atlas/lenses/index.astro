---
import AtlasDateCrosswalk from "../../../components/AtlasDateCrosswalk.astro";
import AtlasEvidenceLens from "../../../components/AtlasEvidenceLens.astro";
import AtlasRelationship from "../../../components/AtlasRelationship.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { atlasCases, atlasCaseHref } from "../../../lib/atlas-cases";
import { atlasHref, getAtlas } from "../../../lib/atlas-data";
import { atlasEvidenceLenses, atlasLensTasks, projectAtlasEvidenceLens } from "../../../lib/atlas-evidence-lens";
const atlas = getAtlas();
const cases = atlasCases.map((item) => {
  const all = projectAtlasEvidenceLens(atlas, {}, item.workId);
  const task = atlasLensTasks[item.key];
  if (!task || !all.focus) throw new Error(`Missing grounded lens case ${item.key}.`);
  return { ...item, all, focus: all.focus, task, lenses: atlasEvidenceLenses.map((lens) => ({ ...lens, view: projectAtlasEvidenceLens(atlas, lens.constraints, item.workId) })) };
});
---
<BaseLayout title="Expert evidence lenses — LLM Lineage" description="Compare independent evidence, causal-permission and connection-type constraints across four complete research neighborhoods." eyebrow="Expert evidence lenses">
  <div class="shell breadcrumb"><a href="/atlas/">Atlas</a><span aria-hidden="true">/</span><a href="/atlas/cases/expert/">expert connection studies</a><span aria-hidden="true">/</span><span aria-current="page">evidence lenses</span></div>
  <header class="shell atlas-hero neighborhood-hero lens-hero">
    <p class="eyebrow">Expert comparison · four fixed neighborhoods</p>
    <h1>Hold the work fixed. Compare the evidence lenses.</h1>
    <p>Intersect three independent fields, account for what remains, and audit every exclusion. Each count comes from the same corpus; each local record keeps its complete evidence.</p>
    <p class="atlas-small">Eight static lenses use native links and disclosures. Their inspection benefit has not been evaluated. Selected 1913–2025 history includes later revisions; this is not a new coverage review.</p>
    <nav class="atlas-section-nav" aria-label="Evidence-lens studies">{cases.map((item, index) => <a href={`#lens-case-${item.key}`}>0{index + 1} · {item.key.replaceAll("-", " ")}</a>)}</nav>
    <p class="atlas-small"><a href="/atlas/expert/#catalogue">Complete expert catalogue</a> · <a href="/atlas/evidence/#relationships">All {atlas.counts.relationships} relationships</a> · <a href="https://github.com/TheSyBuilder/how-llms-happened/blob/main/docs/atlas-evidence-lens-comparison.md">Comparison protocol</a></p>
  </header>
  <section class="shell lens-reading-key" aria-labelledby="lens-key-heading">
    <h2 id="lens-key-heading">Three fields. Three scopes.</h2>
    <dl class="atlas-evidence-key">
      <div><dt>Evidence class</dt><dd>Describes the evidential basis: documented influence, inherited mechanism or editorial synthesis. It is not a confidence ranking.</dd></div>
      <div><dt>Causal permission</dt><dd>Independently permits qualified wording or prohibits causal language. Documented evidence can still prohibit causality.</dd></div>
      <div><dt>Connection type</dt><dd>Names the recorded relationship, such as builds-on, combines or addresses. Matching a type never transfers every method or result.</dd></div>
    </dl>
    <p><strong>Here</strong> means records touching the focus work. <strong>Outside</strong> means records outside that incident list. <strong>Corpus</strong> means all {atlas.counts.relationships} recorded relationships. Counts describe records, not distinct neighbors or importance.</p>
    <p class="atlas-boundary">All selected fields must match: evidence AND permission AND type. Local matches + local exclusions = all incident records. Local matches + matches elsewhere = corpus matches. No transitive influence is inferred.</p>
  </section>
  {cases.map((item, index) => <section class="shell neighborhood-case lens-case" id={`lens-case-${item.key}`} aria-labelledby={`lens-heading-${item.key}`} data-focus-work={item.workId}>
    <header><p class="eyebrow">Study 0{index + 1} · intersect, account, audit</p><h2 id={`lens-heading-${item.key}`}>{item.heading}</h2><p class="neighborhood-focus-title"><a href={atlasHref("expert", item.workId)}>{item.focus.record.title}</a></p></header>
    <AtlasDateCrosswalk work={item.focus} />
    <div class="neighborhood-task lens-task"><p class="eyebrow">Field and source audit</p><p>{item.task.prompt}</p><details class="atlas-disclosure lens-answer"><summary>Check the bounded interpretation</summary><div class="atlas-detail-body"><p>{item.task.explanation}</p><a href={`#lens-${item.key}-record-${item.id}`}>Audit the grounded study connection</a></div></details></div>
    <dl class="lens-counts lens-scope" aria-label="Unfiltered record scope">
      <div><dt>All incident records</dt><dd>{item.all.counts.total}</dd></div>
      <div><dt>All outside records</dt><dd>{item.all.counts.outsideTotal}</dd></div>
      <div><dt>Complete corpus</dt><dd>{item.all.counts.globalTotal}</dd></div>
    </dl>
    <div class="lens-comparison" id={`lens-${item.key}-counts`}>
      <table class="lens-table" aria-describedby={`lens-${item.key}-table-note`}>
        <caption>Matched records under each lens · study 0{index + 1}</caption>
        <colgroup><col class="lens-name-column" /><col /><col /><col /></colgroup>
        <thead><tr><th scope="col">Lens</th><th scope="col">Here</th><th scope="col">Outside</th><th scope="col">Corpus</th></tr></thead>
        <tbody>{item.lenses.map((lens) => <tr data-count-lens={lens.key}><th scope="row"><a href={`#lens-${item.key}-${lens.key}`}>{lens.label}</a></th><td>{lens.view.counts.matched} <span>of {lens.view.counts.total}</span></td><td>{lens.view.counts.outsideMatched} <span>of {lens.view.counts.outsideTotal}</span></td><td>{lens.view.counts.globalMatched} <span>of {lens.view.counts.globalTotal}</span></td></tr>)}</tbody>
      </table>
      <p class="atlas-small" id={`lens-${item.key}-table-note`}>Each cell gives matches within its scope. Here and Outside partition the corpus. Follow a lens name, then open its disclosure for exact constraints, retained IDs and every excluded field.</p>
    </div>
    <div class="lens-comparators" aria-label="Static lens results">{item.lenses.map((lens) => <AtlasEvidenceLens caseKey={item.key} lensKey={lens.key} label={lens.label} view={lens.view} incident={item.all.relationships} />)}</div>
    <section class="lens-full-evidence" id={`lens-${item.key}-evidence`} aria-labelledby={`lens-${item.key}-evidence-heading`}>
      <h3 id={`lens-${item.key}-evidence-heading`}>Complete incident list · {item.all.counts.total} records</h3><p class="atlas-small">Every local record remains available below, regardless of a lens. R-numbers are local reading labels in corpus order; they do not rank connections.</p>
      {item.all.relationships.map((relation, relationIndex) => <div class:list={["neighborhood-record", { "neighborhood-record--target": relation.record.id === item.id }]}><p class="neighborhood-record-label">R{relationIndex + 1}{relation.record.id === item.id ? " · grounded study connection" : " · incident connection"}</p><AtlasRelationship relation={relation} idPrefix={`lens-${item.key}-record`} indexHref={`#lens-${item.key}-evidence`} /></div>)}
    </section>
    <div class="neighborhood-return"><a href={atlasCaseHref("expert", item.key)}>Return to this expert connection study</a><a href={atlasCaseHref("beginner", item.key)}>Try this study in beginner mode</a><a href="#main-content">Return to lens navigation ↑</a></div>
  </section>)}
</BaseLayout>
