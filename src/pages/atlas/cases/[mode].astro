---
import AtlasDateCrosswalk from "../../../components/AtlasDateCrosswalk.astro";
import AtlasNeighborhood from "../../../components/AtlasNeighborhood.astro";
import ModeSwitch from "../../../components/ModeSwitch.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { atlasCases, atlasCaseHref } from "../../../lib/atlas-cases";
import { atlasHref, getAtlas, projectAtlasNeighborhood } from "../../../lib/atlas-data";
import type { Mode } from "../../../lib/site-data";
export function getStaticPaths() { return ["beginner", "expert"].map((mode) => ({ params: { mode } })); }
const mode = Astro.params.mode as Mode;
const alternate = mode === "beginner" ? "expert" : "beginner";
const atlas = getAtlas();
const cases = atlasCases.map((item) => ({ ...item, neighborhood: projectAtlasNeighborhood(atlas, item.workId) }));
---
<BaseLayout title={`${mode === "beginner" ? "Beginner" : "Expert"} connection studies — LLM Lineage`} description="Four source-backed local neighborhoods for comparing dates, versions and the limits of recorded research connections." eyebrow={`${mode} connection studies`}>
  <div class="shell breadcrumb"><a href="/atlas/">Atlas</a><span aria-hidden="true">/</span><a href={`/atlas/${mode}/`}>{mode} catalogue</a><span aria-hidden="true">/</span><span aria-current="page">connection studies</span></div>
  <header class="shell atlas-hero neighborhood-hero">
    <p class="eyebrow">Four local studies · one shared corpus</p>
    <h1>{mode === "beginner" ? "A connection is a question worth checking." : "Inspect the neighborhood. Audit the scope."}</h1>
    <p>{mode === "beginner" ? "Start with a prediction, then compare the dates and inspect the evidence. Each study keeps one work in focus and shows only its recorded neighbors." : "Separate ordering events from canonical versions, then audit the three independent relationship fields and their version-bound locators."}</p>
    <p class="atlas-small">Selected research history, 1913–2025. Includes later revisions; coverage is selective and expanding. Optional diagrams are a comparison prototype; their learning benefit has not been evaluated.</p>
    <ModeSwitch activeMode={mode} alternateHref={`/atlas/cases/${alternate}/`} />
    <nav class="atlas-section-nav" aria-label="Connection studies">{cases.map((item, index) => <a href={`#case-${item.key}`}>0{index + 1} · {item.key.replaceAll("-", " ")}</a>)}</nav>
    <p class="atlas-small"><a href={`/atlas/${mode}/#catalogue`}>Return to the complete catalogue</a> · <a href="https://github.com/TheSyBuilder/how-llms-happened/blob/main/docs/atlas-neighborhood-comparison.md">Comparison protocol</a></p>
  </header>
  {cases.map((item, index) => <section class="shell neighborhood-case" id={`case-${item.key}`} aria-labelledby={`heading-${item.key}`} data-focus-work={item.workId}>
    <header><p class="eyebrow">Study 0{index + 1} · {mode === "beginner" ? "Predict, compare, inspect" : "Event, version, locator"}</p><h2 id={`heading-${item.key}`}>{item.heading}</h2><p class="neighborhood-focus-title"><a href={atlasHref(mode, item.workId)}>{item.neighborhood.focus.record.title}</a></p></header>
    <AtlasDateCrosswalk work={item.neighborhood.focus} />
    <div class="neighborhood-task">
      <p class="eyebrow">{mode === "beginner" ? "Before you inspect" : "Evidence audit"}</p>
      <p>{mode === "beginner" ? item.prompt : item.audit}</p>
      {mode === "beginner" ? <details class="atlas-disclosure neighborhood-answer"><summary>Reveal the bounded explanation</summary><div class="atlas-detail-body"><p>{item.answer}</p><a href={`#case-${item.key}-relation-${item.id}`}>Inspect the study connection</a></div></details> : <a href={`#case-${item.key}-relation-${item.id}`}>Locate the relationship and source locators</a>}
    </div>
    <AtlasNeighborhood neighborhood={item.neighborhood} caseKey={item.key} targetId={item.id} mode={mode} />
    <div class="neighborhood-return"><a href={atlasCaseHref(alternate, item.key)}>Continue this study in {alternate} mode</a><a href={`/atlas/${mode}/#work-${item.workId}`}>Return to this work in the catalogue</a><a href="#main-content">Return to study navigation ↑</a></div>
  </section>)}
</BaseLayout>
