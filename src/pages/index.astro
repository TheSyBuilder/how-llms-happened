---
import LineageLayout from "../layouts/LineageLayout.astro";
import Gpt2Challenge from "../components/hero/Gpt2Challenge";
import EraSpine from "../components/home/EraSpine.astro";
import GameLibrary from "../components/home/GameLibrary.astro";
import { chapterMeta } from "../lib/chapter-meta";
import "../styles/game.css";
import "../styles/home.css";
const first = chapterMeta[0]!;
---
<LineageLayout title="LLM Lineage — how language models happened" description="From letter counts to language models: an interactive timeline of the ideas that changed how computers work with words.">
  <section class="home-hero page-width" aria-labelledby="home-title">
    <div class="home-copy">
      <p class="home-kicker"><button type="button" class="home-capsule" data-curiosity="1913" aria-label="Open the 1913 time capsule" title="A little history is hiding here">{first.year}</button><span>– today</span><span aria-hidden="true">·</span><span>{`${chapterMeta.length} tiny games`}</span></p>
      <h1 id="home-title" class="home-title">How did counting letters turn into a machine you can <em>talk to</em>?</h1>
      <p class="home-subtitle">From 1913 to today, one tiny game per idea. No ML needed. Every game is a real paper.</p>
    </div>
    <div class="home-game"><Gpt2Challenge client:load /></div>
    <div class="home-actions">
      <a class="game-btn is-primary" href={`/chapters/${first.slug}/#play`}>{`Start at ${first.year}`} <span class="home-arrow" aria-hidden="true">→</span></a>
      <button type="button" class="game-btn" data-open-explorer>All games</button>
    </div>
  </section>
  <EraSpine />
  <GameLibrary />
  <section class="home-why page-width" aria-labelledby="why-title">
    <h2 id="why-title">Why this exists</h2>
    <p>Most explanations of language models start at the end. This one starts in 1913 and lets you play every step.</p>
    <div class="home-why-links"><a class="game-btn" href="https://x.com/TheSyBuilder" target="_blank" rel="noopener noreferrer">Follow on X ↗</a><a class="game-btn" href="https://github.com/TheSyBuilder/how-llms-happened" target="_blank" rel="noopener noreferrer">Source on GitHub ↗</a></div>
  </section>
</LineageLayout>

<script>
import "../components/home/progress-marks";
</script>
