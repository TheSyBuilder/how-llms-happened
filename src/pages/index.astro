---
import FirstExperiment from "../components/FirstExperiment";
import LineageLayout from "../layouts/LineageLayout.astro";
import { timeline, chapters, chapterHref } from "../lib/chapters";
const live = chapters.filter(chapter => chapter.status === "live");
---
<LineageLayout title="LLM Lineage — how language models happened" description="From letter counts to language models: an interactive timeline of the ideas that changed how computers work with words.">
  <section class="timeline-intro page-width home-opening">
    <div class="opening-copy"><p class="eyebrow">1913 → today · a history you can play</p><h1>How did we<br/>get to <span>this?</span></h1><p class="opening-description">A machine that finishes your sentence. Answers a question. Follows a thought.<br/>Meet the ideas that made it happen—by trying them yourself.</p><a class="primary-link" href="/chapters/transformer/">Start with the Transformer ↗</a><p class="opening-footnote">{live.length} playable chapters · tiny experiments · original sources</p></div>
    <FirstExperiment client:load />
  </section>
  <section class="entry-points page-width" aria-label="Choose a starting point"><div><p class="eyebrow">Follow your curiosity</p><h2>Three good rabbit holes.</h2></div><div class="entry-links"><a href="/chapters/transformer/#play"><span>01 / INSIDE THE MODEL</span><strong>What is attention actually doing?</strong><p>Steer where a word looks. Watch its information change.</p><b aria-hidden="true">↗</b></a><a href="/chapters/human-feedback/#play"><span>02 / THE SURPRISING BIT</span><strong>Can a better score make a worse answer?</strong><p>Teach a preference. Discover what the scorer missed.</p><b aria-hidden="true">↗</b></a><a href="/chapters/reasoning/#play"><span>03 / THE NEXT QUESTION</span><strong>Does thinking longer always help?</strong><p>Spend a search budget. See when another attempt matters.</p><b aria-hidden="true">↗</b></a></div></section>
  <section class="timeline-section" id="timeline" aria-labelledby="timeline-heading">
    <div class="timeline-heading page-width"><div><p class="eyebrow">The story so far</p><h2 id="timeline-heading">Follow the thread.</h2></div><p>{live.length} {live.length === 1 ? "chapter" : "chapters"} live · {chapters.length} turning points<br /><span>Scroll across to travel through time →</span></p></div>
    <nav class="era-jumps page-width" aria-label="Jump along the timeline"><span>Jump to</span><button data-era="next-letter">The beginnings</button><button data-era="transformer">2017 · Transformers</button><button data-era="gpt-3">2020 · Scaling up</button><button data-era="reasoning">2025 · Reasoning</button></nav>
    <div class="timeline-strip" tabindex="0" aria-label="Chapter timeline, scroll horizontally with arrow keys">
      <ol class="timeline-cards">
        {timeline.map((chapter, i) => <li id={chapter.slug} class:list={["timeline-card", { "is-live": chapter.status === "live" }]}>
          <div class="timeline-date"><time>{chapter.year}</time><span aria-hidden="true">{String(i + 1).padStart(2, "0")}</span></div>
          <a href={chapterHref(chapter.slug)}><span class="chapter-status">{chapter.status === "live" ? "● Live · play now" : "Coming soon"}</span><h3>{chapter.title}</h3><p>{chapter.hook}</p><span class="card-arrow" aria-hidden="true">↗</span></a>
        </li>)}
      </ol>
    </div>
    <div class="timeline-bottom page-width"><span>Small experiments, right in your browser.</span><a href={chapterHref(live[live.length - 1]!.slug)}>Jump to the latest chapter →</a></div>
  </section>
  <section class="reading-note page-width"><p class="eyebrow">No prerequisites. Just curiosity.</p><h2>Understand the idea.<br />Then get your hands on it.</h2><p>Each chapter starts with a question, explains the breakthrough, and gives you a tiny toy to try. Open “Go deeper” for the math, or “Sources” to read the original work.</p></section>
</LineageLayout>

<script>
for(const button of document.querySelectorAll<HTMLButtonElement>('[data-era]')) button.addEventListener('click',()=>{
 const card=document.getElementById(button.dataset.era!);
 const strip=document.querySelector<HTMLElement>('.timeline-strip');
 if(card&&strip){strip.scrollTo({left:card.offsetLeft-strip.offsetLeft-24,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});}
});
</script>
