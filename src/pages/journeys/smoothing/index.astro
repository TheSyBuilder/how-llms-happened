---
import JourneyMap from "../../../components/JourneyMap.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getJourneyOverview } from "../../../lib/site-data";

const journey = getJourneyOverview();
---

<BaseLayout
  title="The smoothing story — LLM Lineage"
  description="Choose an intuition-led or equation-led path through the history of sparse language-model estimation."
  eyebrow="Learning journey"
>
  <section class="journey-hero">
    <p class="eyebrow">Journey 01 · probability under sparse evidence</p>
    <h1>{journey.question}</h1>
    <p>
      The chronology is shared. The work you do is not. Choose a path based on how you want to test your understanding.
    </p>
  </section>

  <section class="shell path-grid" aria-label="Choose a learning path">
    <article class="path-choice">
      <p class="kicker">Beginner · about {journey.estimatedMinutes.beginner} minutes</p>
      <h2>Follow the probability</h2>
      <ul>
        <li>Start from counts, seen events, and unseen events.</li>
        <li>Predict where reserved probability should go.</li>
        <li>Meet one historical distinction at a time.</li>
      </ul>
      <a class="button" href="/journeys/smoothing/beginner/">Preview the beginner path</a>
    </article>
    <article class="path-choice">
      <p class="kicker">Expert · about {journey.estimatedMinutes.expert} minutes</p>
      <h2>Reconstruct the estimator</h2>
      <ul>
        <li>Audit version scope, notation, and claim evidence.</li>
        <li>Recover normalization terms from reviewed fixtures.</li>
        <li>Keep original and later implementations separate.</li>
      </ul>
      <a class="button" href="/journeys/smoothing/expert/">Preview the expert path</a>
    </article>
  </section>

  <section class="shell mt-5" aria-labelledby="journey-stages">
    <p class="eyebrow">Shared factual sequence</p>
    <h2 id="journey-stages" class="mt-3">Four changes, one source trail</h2>
    <div class="mt-4"><JourneyMap journey={journey} /></div>
  </section>
</BaseLayout>
