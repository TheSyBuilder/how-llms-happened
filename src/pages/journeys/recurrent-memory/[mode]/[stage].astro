---
import SundermeyerChapter from "../../../../components/SundermeyerChapter.astro";
import ElmanChapter from "../../../../components/ElmanChapter.astro";
import OriginalLstmChapter from "../../../../components/OriginalLstmChapter.astro";
import PeepholeChapter from "../../../../components/PeepholeChapter.astro";
import MikolovChapter from "../../../../components/MikolovChapter.astro";
import ForgetGateChapter from "../../../../components/ForgetGateChapter.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { getBuiltStagePaths, getStageView } from "../../../../lib/site-data";
export function getStaticPaths() { return getBuiltStagePaths("recurrent-memory"); }
const mode = Astro.params.mode;
const slug = Astro.params.stage;
if ((mode !== "beginner" && mode !== "expert") || (slug !== "elman-1988-1990" && slug !== "hochreiter-schmidhuber-1995-1997" && slug !== "gers-1999-2000" && slug !== "gers-2002" && slug !== "mikolov-2010" && slug !== "sundermeyer-2012")) throw new Error("No recurrent stage treatment defined.");
const view = getStageView(mode, slug, "recurrent-memory");
const elman = slug === "elman-1988-1990";
const original = slug === "hochreiter-schmidhuber-1995-1997";
const retention = slug === "gers-1999-2000";
const peephole = slug === "gers-2002";
const wordModel = slug === "mikolov-2010";
const label = elman ? "Elman 1988/1990" : original ? "Original LSTM 1995/1997" : retention ? "Forget gates 1999/2000" : peephole ? "Peepholes 2002" : wordModel ? "Recurrent word models 2010" : "LSTM word models 2012";
const description = elman
  ? "Elman's context copy, history-dependent hidden state, local training boundary, and source-dated lexical evidence."
  : original ? "The original LSTM's fixed unit self-loop, writing and exposure gates, scoped backward credit, and synthetic-task evidence."
  : retention ? "Adaptive retention with a fixed write, journal eligibility equations, and version-bound synthetic continual prediction evidence."
  : peephole ? "Previous-state and updated-state gate reads, source equations, truncated peephole learning, and synthetic timing evidence."
  : wordModel ? "Fixed-window prerequisites, normalized recurrent word prediction, depth-one temporal credit, and component-labelled language-model evidence."
  : "Source-dated composite memory, normalized word objectives, graph-only context evidence, and the French count-model mixture.";
---

<BaseLayout title={`${mode === "beginner" ? "Beginner" : "Expert"}: ${label} — LLM Lineage`} description={description} eyebrow={`${mode} journey`}>
  <div class="shell breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/journeys/recurrent-memory/">Recurrent memory</a><span aria-hidden="true">/</span><a href={`/journeys/recurrent-memory/${mode}/`}>{mode}</a><span aria-hidden="true">/</span><span aria-current="page">{label}</span></div>
  {elman ? <ElmanChapter view={view} /> : original ? <OriginalLstmChapter view={view} /> : retention ? <ForgetGateChapter view={view} /> : peephole ? <PeepholeChapter view={view} /> : wordModel ? <MikolovChapter view={view} /> : <SundermeyerChapter view={view} />}
</BaseLayout>
