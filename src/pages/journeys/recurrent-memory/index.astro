---
import JourneyMap from "../../../components/JourneyMap.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getJourneyOverview } from "../../../lib/site-data";
const journey = getJourneyOverview("recurrent-memory");
---

<BaseLayout title="The recurrent-memory story — LLM Lineage" description="Two paths through carried state, protected memory, later gates, and recurrent word models." eyebrow="Learning journey">
  <section class="journey-hero">
    <p class="eyebrow">Journey 02 · memory as ongoing processing</p>
    <h1>{journey.question}</h1>
    <p class="mt-4">Begin with a small question: can the same token produce different internal states? Follow the carried-state and gated-memory branches toward their later word-model convergence.</p>
    <p class="provenance-note mt-4">Elman and the original LSTM cell are available in both modes. Four later chapters are queued; the map shows the full intended sequence.</p>
  </section>
  <section class="shell path-grid" aria-label="Choose a learning path">
    <article class="path-choice">
      <p class="kicker">Beginner · predict and explain</p><h2>Follow what gets carried.</h2>
      <ul><li>Compare one token after two histories.</li><li>Distinguish writing a state from exposing it.</li><li>Follow state and a teaching signal separately.</li></ul>
      <a class="button" href="/journeys/recurrent-memory/beginner/">Preview the beginner path</a>
    </article>
    <article class="path-choice">
      <p class="kicker">Expert · reconstruct and audit</p><h2>Separate state from credit.</h2>
      <ul><li>Distinguish a context copy from a protected cell path.</li><li>Reconstruct source equations and local truncation.</li><li>Audit synthetic traces against source experiment scope.</li></ul>
      <a class="button" href="/journeys/recurrent-memory/expert/">Preview the expert path</a>
    </article>
  </section>
  <section class="shell mt-5" aria-labelledby="recurrent-stages">
    <p class="eyebrow">Shared factual sequence</p><h2 id="recurrent-stages" class="mt-3">Two branches, a later convergence</h2>
    <div class="mt-4"><JourneyMap journey={journey} /></div>
  </section>
</BaseLayout>
