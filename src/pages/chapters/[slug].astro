---
import NeuralLanguageStory from "../../components/NeuralLanguageStory.astro";
import EarlyStory from "../../components/early/EarlyStory.astro";
import {earlyStories} from "../../lib/early-stories";
import ChapterEnd from "../../components/ChapterEnd.astro";
import LaterStory from "../../components/LaterStory.astro";
import { laterStories } from "../../lib/later-stories";
import LineageLayout from "../../layouts/LineageLayout.astro";
import TransformerStory from "../../components/TransformerStory.astro";
import PretrainingStory from "../../components/PretrainingStory.astro";
import BertStory from "../../components/BertStory.astro";
import Gpt2Story from "../../components/Gpt2Story.astro";
import ScalingStory from "../../components/ScalingStory.astro";
import Gpt3Story from "../../components/Gpt3Story.astro";
import RetrievalStory from "../../components/RetrievalStory.astro";
import ChatgptStory from "../../components/ChatgptStory.astro";
import Gpt4Story from "../../components/Gpt4Story.astro";
import HumanFeedbackStory from "../../components/HumanFeedbackStory.astro";
import RecurrenceStory from "../../components/RecurrenceStory.astro";
import NowStory from "../../components/NowStory.astro";
import { chapters, chapterPaper, chapterHref } from "../../lib/chapters";
export function getStaticPaths() { return chapters.map(chapter => ({ params: { slug: chapter.slug }, props: { chapter } })); }
const { chapter } = Astro.props;
const paper = chapterPaper(chapter.anchor)!;
const playable=chapters.filter(c=>c.status==='live');
const index=playable.findIndex(c=>c.slug===chapter.slug);
const previous=playable[(index-1+playable.length)%playable.length]!;
const next=playable[(index+1)%playable.length]!;
---
<LineageLayout title={`${chapter.title} — LLM Lineage`} description={chapter.hook}>
  <article class:list={["chapter-page", { "is-coming": chapter.status !== "live" }]}>
    <header class="chapter-hero page-width"><a class="back-link" href={`/#${chapter.slug}`}>← The timeline</a><p class="eyebrow">{chapter.year} / {chapter.status === "live" ? "Live chapter" : "Coming soon"}</p><h1>{chapter.title}</h1><p class="chapter-hook">{chapter.hook}</p><a class="paper-credit" href={paper.url}>{paper.title} ↗</a>{chapter.status === "live" && <nav class="chapter-nav" aria-label="In this chapter"><a href="#play" data-chapter-view="play">Play</a><a href="#problem" data-chapter-view="story">Story</a><a href="#deeper" data-chapter-view="reference">Math &amp; sources</a><a class="nav-paper" href={paper.url} target="_blank" rel="noopener noreferrer" aria-label={`Original paper: ${paper.title}`}>Paper ↗</a></nav>}</header>
    <div class="story-width">{chapter.slug === "transformer" ? <TransformerStory /> : chapter.slug === "pretraining" ? <PretrainingStory /> : chapter.slug === "bert" ? <BertStory /> : chapter.slug === "gpt-2" ? <Gpt2Story /> : chapter.slug === "scaling-laws" ? <ScalingStory /> : chapter.slug === "gpt-3" ? <Gpt3Story /> : chapter.slug === "retrieval" ? <RetrievalStory /> : chapter.slug === "human-feedback" ? <HumanFeedbackStory /> : chapter.slug === "chatgpt" ? <ChatgptStory /> : chapter.slug === "gpt-4" ? <Gpt4Story /> : chapter.slug === "now" ? <NowStory /> : chapter.slug === "drop-recurrence" ? <RecurrenceStory /> : chapter.slug === "neural-language-model" ? <NeuralLanguageStory /> : earlyStories[chapter.slug] ? <EarlyStory slug={chapter.slug} /> : laterStories[chapter.slug] ? <LaterStory chapter={chapter} /> : <section class="coming-soon"><p class="eyebrow">This part of the story is on its way</p><h2>A question worth playing with.</h2><p>This chapter will explore: {chapter.toy.charAt(0).toLowerCase() + chapter.toy.slice(1)}</p><p>While it takes shape, try the attention playground in the first live chapter.</p><a class="primary-link" href={chapterHref("transformer")}>Play with the Transformer ↗</a>{chapter.related.length > 0 && <details class="chapter-disclosure"><summary>Also in this chapter</summary><ul class="source-list">{chapter.related.map(id => { const work = chapterPaper(id)!; return <li><a href={work.url}>{work.title} ↗</a></li>; })}</ul></details>}</section>}{chapter.status === "live" && <ChapterEnd slug={chapter.slug} />}</div>
    {chapter.status === 'live' && <nav class="game-dock" aria-label="Switch experiments"><a href={`/chapters/${previous.slug}/#play`} aria-label={`Previous experiment: ${previous.title}`}>← <span>Previous</span></a><button data-open-explorer><span>{String(index+1).padStart(2,'0')} / {playable.length}</span> Switch experiment <b aria-hidden="true">⌄</b></button><a href={`/chapters/${next.slug}/#play`} aria-label={`Next experiment: ${next.title}`}><span>Next</span> →</a></nav>}
  </article>
</LineageLayout>

<script>
const article=document.querySelector<HTMLElement>('.chapter-page')!;
function syncChapterView(){
 const hash=location.hash;
 const view=hash==='#play'?'play':hash==='#deeper'||hash==='#sources'?'reference':'story';
 article.dataset.view=view;
 for(const link of article.querySelectorAll<HTMLElement>('[data-chapter-view]')){
  if(link.dataset.chapterView===view)link.setAttribute('aria-current','true');else link.removeAttribute('aria-current');
 }
 if(view==='reference'){
  const target=document.querySelector<HTMLDetailsElement>(hash);if(target)target.open=true;
 }
}
syncChapterView();
window.addEventListener('hashchange',()=>{syncChapterView();requestAnimationFrame(()=>{if(article.dataset.view!=='story')window.scrollTo({top:0,behavior:'instant'});});});
</script>
