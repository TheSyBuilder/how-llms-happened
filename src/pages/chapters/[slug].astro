---
import ChapterEnd from "../../components/ChapterEnd.astro";
import LaterStory from "../../components/LaterStory.astro";
import { laterStories } from "../../lib/later-stories";
import LineageLayout from "../../layouts/LineageLayout.astro";
import TransformerStory from "../../components/TransformerStory.astro";
import PretrainingStory from "../../components/PretrainingStory.astro";
import BertStory from "../../components/BertStory.astro";
import Gpt2Story from "../../components/Gpt2Story.astro";
import ScalingStory from "../../components/ScalingStory.astro";
import Gpt3Story from "../../components/Gpt3Story.astro";
import RetrievalStory from "../../components/RetrievalStory.astro";
import ChatgptStory from "../../components/ChatgptStory.astro";
import Gpt4Story from "../../components/Gpt4Story.astro";
import HumanFeedbackStory from "../../components/HumanFeedbackStory.astro";
import { chapters, chapterPaper, chapterHref } from "../../lib/chapters";
export function getStaticPaths() { return chapters.map(chapter => ({ params: { slug: chapter.slug }, props: { chapter } })); }
const { chapter } = Astro.props;
const paper = chapterPaper(chapter.anchor)!;
---
<LineageLayout title={`${chapter.title} — LLM Lineage`} description={chapter.hook}>
  <article class:list={["chapter-page", { "is-coming": chapter.status !== "live" }]}>
    <header class="chapter-hero page-width"><a class="back-link" href={`/#${chapter.slug}`}>← The timeline</a><p class="eyebrow">{chapter.year} / {chapter.status === "live" ? "Live chapter" : "Coming soon"}</p><h1>{chapter.title}</h1><p class="chapter-hook">{chapter.hook}</p><a class="paper-credit" href={paper.url}>{paper.title} ↗</a>{chapter.status === "live" && <nav class="chapter-nav" aria-label="In this chapter"><a href="#idea">The idea</a><a href="#play">Play with it ↓</a><a href="#deeper">Go deeper</a></nav>}</header>
    <div class="story-width">{chapter.slug === "transformer" ? <TransformerStory /> : chapter.slug === "pretraining" ? <PretrainingStory /> : chapter.slug === "bert" ? <BertStory /> : chapter.slug === "gpt-2" ? <Gpt2Story /> : chapter.slug === "scaling-laws" ? <ScalingStory /> : chapter.slug === "gpt-3" ? <Gpt3Story /> : chapter.slug === "retrieval" ? <RetrievalStory /> : chapter.slug === "human-feedback" ? <HumanFeedbackStory /> : chapter.slug === "chatgpt" ? <ChatgptStory /> : chapter.slug === "gpt-4" ? <Gpt4Story /> : laterStories[chapter.slug] ? <LaterStory chapter={chapter} /> : <section class="coming-soon"><p class="eyebrow">This part of the story is on its way</p><h2>A question worth playing with.</h2><p>This chapter will explore: {chapter.toy.charAt(0).toLowerCase() + chapter.toy.slice(1)}</p><p>While it takes shape, try the attention playground in the first live chapter.</p><a class="primary-link" href={chapterHref("transformer")}>Play with the Transformer ↗</a>{chapter.related.length > 0 && <details class="chapter-disclosure"><summary>Also in this chapter</summary><ul class="source-list">{chapter.related.map(id => { const work = chapterPaper(id)!; return <li><a href={work.url}>{work.title} ↗</a></li>; })}</ul></details>}</section>}{chapter.status === "live" && <ChapterEnd slug={chapter.slug} />}</div>
  </article>
</LineageLayout>
