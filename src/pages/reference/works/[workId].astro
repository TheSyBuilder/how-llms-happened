---
import { legacyDestination } from "../../../lib/chapters";
import { getBuiltReferenceWorkIds } from "../../../lib/site-data";
export function getStaticPaths() { return getBuiltReferenceWorkIds().map(workId => ({ params: { workId } })); }
return Astro.redirect(legacyDestination(Astro.url.pathname), 301);
