{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-lineage.local/schemas/kneser-ney-fixture.schema.json",
  "title": "LLM Lineage synthetic Kneser–Ney context-coverage fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "id", "kind", "label", "description", "representedClaimIds", "scenarios"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "kind": { "const": "kneser-ney-context-coverage" },
    "label": { "const": "Synthetic example" },
    "description": { "type": "string", "minLength": 1 },
    "representedClaimIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "mode": { "enum": ["beginner", "expert"] },
    "probability": { "type": "number", "minimum": 0, "maximum": 1 },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predecessor", "count"],
      "properties": {
        "predecessor": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "contexts"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "contexts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/context" }
        }
      }
    },
    "expectedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "rawCount", "ordinaryProbability", "distinctContextCount", "distinctContextProbability", "singletonContextCount", "singletonContextProbability"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "rawCount": { "type": "integer", "minimum": 1 },
        "ordinaryProbability": { "$ref": "#/$defs/probability" },
        "distinctContextCount": { "type": "integer", "minimum": 1 },
        "distinctContextProbability": { "$ref": "#/$defs/probability" },
        "singletonContextCount": { "type": "integer", "minimum": 0 },
        "singletonContextProbability": { "$ref": "#/$defs/probability" }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description", "candidates", "expected"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/candidate" }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["totalTokens", "totalDistinctContexts", "totalSingletonContexts", "candidates"],
          "properties": {
            "totalTokens": { "type": "integer", "minimum": 1 },
            "totalDistinctContexts": { "type": "integer", "minimum": 1 },
            "totalSingletonContexts": { "type": "integer", "minimum": 1 },
            "candidates": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/expectedCandidate" }
            }
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description", "prompt", "modes", "focusWord", "states"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/mode" }
        },
        "focusWord": { "type": "string", "minLength": 1 },
        "states": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/state" }
        }
      }
    }
  }
}
